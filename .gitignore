# Python
__pycache__/
*.pyc
*.pyo

# 特徴量キャッシュ・中間バイナリ（再生成可能・巨大）
sim/_cache/
*.npz

# 一時 / クラッシュ / ロック
*.stackdump
~$*
*.tmp
tmp/

# ベンダー参照資料（ROHM PDF等：著作権のためローカル保管のみ）
doc/

# KiCad manufacturing and validation outputs (regenerated locally)
hardware/stamp_s3a_interposer/build/
hardware/stamp_s3a_interposer/*.kicad_prl
hardware/stamp_s3a_interposer/*.lck
hardware/stamp_s3a_interposer/*-backups/
hardware/stamp_s3a_interposer/*_check.pdf

# Freerouting log (written to en/ by stale tool setting)
en/freerouting.log

# Firmware staging builds (LEXIDE project copies)
.local/

# Solist-AI Sim 用の大容量 CSV (sim/make_solist_dataset.py で再生成可能, 合計 ~70 MB)
sim_export/solist_ds/train_*.csv
sim_export/solist_ds/test_*.csv
